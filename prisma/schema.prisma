generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NumberStatus {
  warming_up
  active
  paused
  banned
}

enum LogDirection {
  out
  in
}

enum LogStatus {
  queued
  sent
  delivered
  failed
}

enum FlowStepType {
  send
  delay_branch
  ai_offer
  ai_reply
  end
}

enum NumberStrategy {
  same
  specific
  rotate
}

model WhatsappNumber {
  id                  String       @id @default(cuid())
  label               String
  evolutionInstanceName String     @unique
  evolutionInstanceToken String?
  phoneNumber         String?
  order               Int          @default(0)
  status              NumberStatus @default(warming_up)
  dailyCap            Int          @default(20)
  sentToday           Int          @default(0)
  lastSentAt          DateTime?
  nextEligibleAt      DateTime?
  capResetAt          DateTime?
  warmupStartedAt      DateTime    @default(now())
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  contacts   Contact[]
  messageLogs MessageLog[]
}

model Flow {
  id              String     @id @default(cuid())
  name            String
  sendWindowStart Int?
  sendWindowEnd   Int?
  paused          Boolean    @default(false)
  steps           FlowStep[]
  contacts        Contact[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model FlowStep {
  id             String          @id @default(cuid())
  flowId         String
  flow           Flow            @relation(fields: [flowId], references: [id])
  type           FlowStepType
  position        Int

  // send / ai_offer / ai_reply
  templateKey    String?
  numberStrategy NumberStrategy?
  numberId       String?
  nextStepId     String?
  mediaUrl       String?
  mediaType      String?
  sendWindowStart Int? // nulo = usa a janela do fluxo (ou do padrão global)
  sendWindowEnd   Int?

  // delay_branch
  thresholdMinutes       Int?
  onReplyGotoStepId      String?
  onReplySendTemplateKey String?
  onTimeoutGotoStepId    String?

  // end
  endLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contactsHere Contact[]

  @@index([flowId])
}

model Contact {
  id              String       @id @default(cuid())
  phone           String
  name            String?
  sourceBatch     String?
  niche           String?
  leadSource      String?
  companyData     Json?
  assignedNumberId String?
  assignedNumber  WhatsappNumber? @relation(fields: [assignedNumberId], references: [id])

  currentFlowId   String?
  currentFlow     Flow?        @relation(fields: [currentFlowId], references: [id])
  currentStepId   String?
  currentStep     FlowStep?    @relation(fields: [currentStepId], references: [id])
  stepEnteredAt   DateTime?
  flowStartedAt   DateTime?
  rotateIndex     Int          @default(0)
  stageLabel      String?
  aiPaused        Boolean      @default(false)

  initialSentAt   DateTime?
  msg2SentAt      DateTime?
  firstReplyAt    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  messageLogs MessageLog[]

  @@unique([phone])
  @@index([currentStepId])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  bodyText  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MessageLog {
  id               String       @id @default(cuid())
  contactId        String
  contact          Contact      @relation(fields: [contactId], references: [id])
  numberId         String?
  number           WhatsappNumber? @relation(fields: [numberId], references: [id])
  direction        LogDirection
  templateKey      String?
  body             String
  mediaUrl         String?
  mediaType        String?
  evolutionMessageId String?
  status           LogStatus    @default(queued)
  createdAt        DateTime     @default(now())
  sentAt           DateTime?

  @@index([status])
  @@index([contactId])
}

model Settings {
  id                      Int      @id @default(1)
  newContactsDailyCap     Int      @default(20)
  sendWindowStart         Int      @default(8)
  sendWindowEnd           Int      @default(20)
  minDelaySeconds         Int      @default(45)
  maxDelaySeconds         Int      @default(180)
  warmupDailyCapStart     Int      @default(20)
  warmupDailyCapMax       Int      @default(150)
  warmupRampDays          Int      @default(14)
  updatedAt               DateTime @updatedAt
}
